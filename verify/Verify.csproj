<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EtgVerify</AssemblyName>
    <RootNamespace>EtgVerify</RootNamespace>
    <!-- remote/ holds device captures, not sources -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- the shipped display policy, compiled in so the simulator drives the real code -->
    <Compile Include="../patcher/gungeonhelper/DisplayPolicy.cs" Link="DisplayPolicy.cs" />
    <Compile Include="../patcher/StubEnumResolver.cs" Link="StubEnumResolver.cs" />
  </ItemGroup>

</Project>
